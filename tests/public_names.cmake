cmake_minimum_required(VERSION 3.25)

function(check_header header)
  file(READ "${header}" source)
  set(line 1)
  set(scope 0)
  set(class_0 0)
  set(next_class 0)
  set(angle 0)
  set(previous "")
  set(standard FALSE)
  set(at_line_start TRUE)
  set(language_names char16_t char32_t wchar_t static_assert static_cast const_cast
    dynamic_cast reinterpret_cast thread_local)

  # Collect macros up front so their uses are exempt anywhere in the header.
  string(REGEX MATCHALL "(^|\n)[ \t]*#[ \t]*define[ \t]+[A-Za-z_0-9]+" definitions "${source}")
  foreach(definition IN LISTS definitions)
    string(REGEX MATCH "[A-Za-z_0-9]+$" name "${definition}")
    list(APPEND macros "${name}")
  endforeach()

  while(NOT source STREQUAL "")
    # Consume one lexical unit. Comments, directives and literals are opaque.
    set(skip TRUE)
    if(at_line_start AND source MATCHES "^([ \t]*#[^\n]*\n?)")
      set(token "${CMAKE_MATCH_1}")
      while(token MATCHES "\\\\\n$")
        string(LENGTH "${token}" length)
        string(SUBSTRING "${source}" ${length} -1 rest)
        if(rest STREQUAL "")
          break()
        endif()
        string(REGEX MATCH "^[^\n]*\n?" continuation "${rest}")
        string(APPEND token "${continuation}")
      endwhile()
    elseif(source MATCHES "^(//[^\n]*|[ \t\r]+|\n)")
      set(token "${CMAKE_MATCH_1}")
    elseif(source MATCHES "^/\\*")
      string(FIND "${source}" "*/" end)
      if(end LESS 0)
        message(FATAL_ERROR "${header}:${line}: unterminated comment")
      endif()
      math(EXPR length "${end} + 2")
      string(SUBSTRING "${source}" 0 ${length} token)
    elseif(source MATCHES "^((u8|u|U|L)?R\"([^ ()\\\\\t\r\n]*)\\()")
      set(opening "${CMAKE_MATCH_1}")
      set(closing ")${CMAKE_MATCH_3}\"")
      string(LENGTH "${opening}" start)
      string(SUBSTRING "${source}" ${start} -1 rest)
      string(FIND "${rest}" "${closing}" end)
      if(end LESS 0)
        message(FATAL_ERROR "${header}:${line}: unterminated raw string")
      endif()
      string(LENGTH "${closing}" suffix)
      math(EXPR length "${start} + ${end} + ${suffix}")
      string(SUBSTRING "${source}" 0 ${length} token)
    elseif(source MATCHES [=[^((u8|u|U|L)?("([^"\\]|\\.)*"|'([^'\\]|\\.)*'))]=])
      set(token "${CMAKE_MATCH_1}")
    elseif(source MATCHES "^([a-zA-Z_][a-zA-Z_0-9]*|::|->|[{}:;<>.()=,*&])")
      set(token "${CMAKE_MATCH_1}")
      set(skip FALSE)
    else()
      string(SUBSTRING "${source}" 0 1 token)
    endif()

    string(LENGTH "${token}" length)
    string(SUBSTRING "${source}" ${length} -1 source)
    if(token MATCHES "\n")
      string(REGEX REPLACE "[^\n]+" "" newlines "${token}")
      string(LENGTH "${newlines}" count)
      math(EXPR line "${line} + ${count}")
    endif()
    if(token MATCHES "\n$")
      set(at_line_start TRUE)
    elseif(NOT token MATCHES "^[ \t]+$")
      set(at_line_start FALSE)
    endif()
    if(skip)
      continue()
    endif()

    # Each nested block inherits the enclosing class and its access level.
    if(token MATCHES "^(class|struct)$" AND angle EQUAL 0 AND NOT previous STREQUAL "enum")
      if(token STREQUAL "class")
        set(pending private)
      else()
        set(pending public)
      endif()
    elseif(token STREQUAL "{")
      set(parent ${scope})
      set(enclosing_angle_${scope} ${angle})
      math(EXPR scope "${scope} + 1")
      if(pending)
        math(EXPR next_class "${next_class} + 1")
        set(class_${scope} ${next_class})
        set(access_${scope} "${pending}")
      else()
        set(class_${scope} "${class_${parent}}")
        set(access_${scope} "${access_${parent}}")
      endif()
      unset(pending)
      set(angle 0)
    elseif(token STREQUAL "}")
      if(scope GREATER 0)
        math(EXPR scope "${scope} - 1")
        set(angle ${enclosing_angle_${scope}})
      endif()
    elseif(token STREQUAL ";")
      unset(pending)
      set(angle 0)
    elseif(token STREQUAL ":" AND previous MATCHES "^(private|public|protected)$")
      set(access_${scope} "${previous}")
    endif()

    # Preserve std qualification through :: chains and balanced template arguments.
    set(qualified FALSE)
    if(token STREQUAL "std" OR (previous STREQUAL "::" AND standard))
      set(qualified TRUE)
    elseif(token STREQUAL "<")
      math(EXPR angle "${angle} + 1")
      set(template_${scope}_${angle} "${standard}")
    elseif(token STREQUAL ">" AND angle GREATER 0)
      set(qualified "${template_${scope}_${angle}}")
      math(EXPR angle "${angle} - 1")
    elseif(token STREQUAL "::")
      set(qualified "${standard}")
    endif()
    if(token MATCHES "_" AND NOT qualified AND NOT token IN_LIST macros AND
       NOT token IN_LIST language_names AND NOT previous MATCHES "^(\\.|->)$")
      set(owner "${class_${scope}}")
      if(access_${scope} MATCHES "^(private|protected)$" AND token MATCHES "^[a-z][A-Za-z0-9]*_$")
        set(private_${owner}_${token} TRUE)
      else()
        list(APPEND candidates "${owner}:${line}:${token}")
      endif()
    endif()
    set(previous "${token}")
    set(standard "${qualified}")
  endwhile()

  # An inline method may refer to a private member declared later in its class.
  foreach(candidate IN LISTS candidates)
    string(REGEX MATCH "^([0-9]+):([0-9]+):(.+)$" match "${candidate}")
    if(NOT private_${CMAKE_MATCH_1}_${CMAKE_MATCH_3})
      message(SEND_ERROR "${header}:${CMAKE_MATCH_2}: snake_case public name '${CMAKE_MATCH_3}'")
    endif()
  endforeach()
endfunction()

if(DEFINED HEADER)
  check_header("${HEADER}")
else()
  file(GLOB_RECURSE headers "${CMAKE_CURRENT_LIST_DIR}/../include/isoduo/*.hpp")
  list(APPEND headers "${CMAKE_CURRENT_LIST_DIR}/../cmake/version.hpp.in")
  foreach(header IN LISTS headers)
    check_header("${header}")
  endforeach()
endif()
