cmake_minimum_required(VERSION 3.25)
set(prefix "${BUILD_DIR}/package-prefix")
set(work "${BUILD_DIR}/package-contract")
file(REMOVE_RECURSE "${work}")
file(MAKE_DIRECTORY "${work}/src")
set(configure_options -G "${GENERATOR}" "-DCMAKE_PREFIX_PATH=${prefix}" "-DCMAKE_FIND_USE_PACKAGE_REGISTRY=OFF"
  "-DCMAKE_FIND_USE_SYSTEM_PACKAGE_REGISTRY=OFF"
  "-DCMAKE_BUILD_TYPE=${BUILD_TYPE}" "-DCMAKE_CXX_COMPILER=${COMPILER}" "-DCMAKE_MAKE_PROGRAM=${MAKE_PROGRAM}")
if(MULTI_CONFIG)
  list(APPEND configure_options "-DCMAKE_CONFIGURATION_TYPES=${BUILD_TYPE}")
endif()
function(run_case name package expect_success diagnostic)
  file(WRITE "${work}/src/CMakeLists.txt" "cmake_minimum_required(VERSION 3.25)\nproject(Contract LANGUAGES CXX)\n${package}\n")
  execute_process(COMMAND "${CMAKE_COMMAND}" -S "${work}/src" -B "${work}/${name}" ${configure_options} ${ARGN}
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(expect_success AND result)
    message(FATAL_ERROR "${name} failed: ${output} ${error}")
  elseif(NOT expect_success AND NOT result)
    message(FATAL_ERROR "${name} unexpectedly succeeded")
  endif()
  string(REGEX REPLACE "[ \t\r\n]+" " " log "${output}${error}")
  if(diagnostic AND NOT log MATCHES "${diagnostic}")
    message(FATAL_ERROR "${name}: expected '${diagnostic}' in ${log}")
  endif()
endfunction()
run_case(unknown "find_package(Isoduo REQUIRED COMPONENTS Widgets)" FALSE "Widgets.*available")
run_case(optional [=[
find_package(Isoduo REQUIRED OPTIONAL_COMPONENTS Widgets)
if(Isoduo_Widgets_FOUND OR NOT Isoduo_Core_FOUND OR NOT TARGET Isoduo::Core)
  message(FATAL_ERROR "Unknown optional component must leave Core available")
endif()
]=] TRUE "")
run_case(old "find_package(Isoduo 0.1 REQUIRED)" FALSE "version")
run_case(future "find_package(Isoduo 1.0 REQUIRED)" FALSE "version")
run_case(older "find_package(Isoduo 0.2 REQUIRED)" FALSE "version")
run_case(previous "find_package(Isoduo 0.3 REQUIRED)" FALSE "version")
run_case(current [=[
find_package(Isoduo 0.4 REQUIRED)
if(NOT Isoduo_VERSION VERSION_EQUAL 0.4.1 OR NOT TARGET Isoduo::Core)
  message(FATAL_ERROR "Expected Isoduo 0.4.1 Core")
endif()
foreach(component AppearanceWeb AppearanceMaterial Desktop Diagnostics)
  if(TARGET Isoduo::${component})
    message(FATAL_ERROR "Default lookup imported ${component}")
  endif()
endforeach()
]=] TRUE "")
set(required "find_package(Isoduo REQUIRED COMPONENTS Core)")
run_case(no-prefix "${required}" FALSE "Isoduo" "-DCMAKE_PREFIX_PATH="
  "-DCMAKE_FIND_ROOT_PATH=${work}/empty" "-DCMAKE_FIND_ROOT_PATH_MODE_PACKAGE=ONLY")
if(NOT MULTI_CONFIG)
  run_case(empty-config "${required}" FALSE "specify -DCMAKE_BUILD_TYPE" "-DCMAKE_BUILD_TYPE=")
endif()
if(NOT DESKTOP)
  run_case(missing-desktop "find_package(Isoduo REQUIRED COMPONENTS Desktop)" FALSE "ISODUO_BUILD_DESKTOP=OFF")
endif()
if(WIN32)
  run_case(runtime "${required}" FALSE "runtime mismatch.*consumer MultiThreaded.*Isoduo MultiThreaded.*DLL"
    "-DCMAKE_MSVC_RUNTIME_LIBRARY=MultiThreaded")
  file(COPY "${prefix}/" DESTINATION "${work}/newer-toolset")
  set(config "${work}/newer-toolset/lib/cmake/Isoduo/IsoduoConfig.cmake")
  file(READ "${config}" content)
  string(REPLACE "set(Isoduo_MSVC_TOOLSET_VERSION \"${TOOLSET}\")"
    "set(Isoduo_MSVC_TOOLSET_VERSION \"99.99.99999\")" content "${content}")
  file(WRITE "${config}" "${content}")
  run_case(older-toolset "${required}" TRUE "consumer MSVC toolset ${TOOLSET} is older than.*99[.]99[.]99999"
    "-DCMAKE_PREFIX_PATH=${work}/newer-toolset")
endif()

set(components Core AppearanceWeb AppearanceMaterial)
if(DESKTOP)
  list(APPEND components Desktop Diagnostics)
endif()
function(check_component component header code)
  set(body "find_package(Isoduo REQUIRED COMPONENTS ${component})\n")
  foreach(other IN LISTS components)
    if(other STREQUAL "Core" OR other STREQUAL component)
      set(condition "NOT TARGET")
    else()
      set(condition "TARGET")
    endif()
    string(APPEND body "if(${condition} Isoduo::${other})\n  message(FATAL_ERROR \"Unexpected target state: ${other}\")\nendif()\n")
  endforeach()
  string(APPEND body "add_executable(probe main.cpp)\ntarget_link_libraries(probe PRIVATE Isoduo::${component})")
  file(WRITE "${work}/src/main.cpp" "#include <isoduo/${header}>\nint main() { ${code} }\n")
  run_case("${component}" "${body}" TRUE "")
  execute_process(COMMAND "${CMAKE_COMMAND}" --build "${work}/${component}" --config "${BUILD_TYPE}"
    COMMAND_ERROR_IS_FATAL ANY)
endfunction()
check_component(Core core.hpp "isoduo::Ui ui;")
check_component(AppearanceWeb appearance.hpp "(void)isoduo::webAppearance();")
check_component(AppearanceMaterial appearance.hpp "(void)isoduo::materialAppearance();")
if(DESKTOP)
  check_component(Desktop third_party_notices.hpp "(void)isoduo::thirdPartyNotices();")
  check_component(Diagnostics diagnostics.hpp "isoduo::Diagnostics diagnostics; (void)diagnostics.recent();")
endif()

file(GLOB public_headers RELATIVE "${prefix}/include" "${prefix}/include/isoduo/*.hpp")
set(header_sources)
foreach(header IN LISTS public_headers)
  file(READ "${prefix}/include/${header}" content HEX)
  string(REGEX REPLACE "[0-7][0-9a-f]" "" non_ascii "${content}")
  if(non_ascii)
    message(FATAL_ERROR "Non-ASCII header: ${header}")
  endif()
  get_filename_component(name "${header}" NAME_WE)
  list(APPEND header_sources "${name}.cpp")
  file(WRITE "${work}/src/${name}.cpp" "#include <${header}>\n")
endforeach()
file(WRITE "${work}/src/standard.cpp" [=[
#if defined(_MSVC_LANG)
#  define ACTIVE_LANG _MSVC_LANG
#else
#  define ACTIVE_LANG __cplusplus
#endif
#if ACTIVE_LANG < REQUIRED_LANG
#  error standard too old
#endif
]=])
file(WRITE "${work}/src/CMakeLists.txt" "cmake_minimum_required(VERSION 3.25)\nproject(Headers LANGUAGES CXX)\nfind_package(Isoduo REQUIRED COMPONENTS Core)\nadd_library(headers OBJECT ${header_sources} standard.cpp)\ntarget_compile_definitions(headers PRIVATE REQUIRED_LANG=\${REQUIRED_LANG})\ntarget_link_libraries(headers PRIVATE Isoduo::Core)\n")
foreach(std IN ITEMS 17 23)
  if(std EQUAL 17)
    set(required_lang 202002L)
  else()
    set(required_lang 202003L)
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}" -S "${work}/src" -B "${work}/std${std}" ${configure_options}
    "-DCMAKE_CXX_STANDARD=${std}" "-DREQUIRED_LANG=${required_lang}" RESULT_VARIABLE result)
  if(result)
    message(FATAL_ERROR "Configure std ${std} failed")
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}" --build "${work}/std${std}" --config "${BUILD_TYPE}" RESULT_VARIABLE result)
  if(result)
    message(FATAL_ERROR "Build std ${std} failed")
  endif()
endforeach()

