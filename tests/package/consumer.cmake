cmake_minimum_required(VERSION 3.25)
set(configs "${BUILD_TYPE}")
set(work "${BUILD_DIR}/consumer")
set(options -G "${GENERATOR}" "-DCMAKE_CXX_COMPILER=${COMPILER}" "-DCMAKE_MAKE_PROGRAM=${MAKE_PROGRAM}")
if(CROSS_COMPILER)
  if(NOT WIN32 OR NOT PRODUCER STREQUAL "Clang")
    message("SKIP: cross-compiler check requires a Windows clang-cl package")
    return()
  endif()
  set(program_files "ProgramFiles(x86)")
  find_program(vswhere vswhere HINTS "$ENV{${program_files}}/Microsoft Visual Studio/Installer")
  if(vswhere)
    execute_process(COMMAND "${vswhere}" -products * -requires Microsoft.VisualStudio.Component.VC.Tools.x86.x64
      -version "[17.0,)" -format json -utf8 OUTPUT_VARIABLE instances COMMAND_ERROR_IS_FATAL ANY)
    string(JSON count LENGTH "${instances}")
  endif()
  if(NOT count)
    message("SKIP: cross-compiler check requires Visual Studio with C++ Build Tools")
    return()
  endif()
  math(EXPR last "${count} - 1")
  foreach(index RANGE 0 ${last})
    string(JSON instance GET "${instances}" ${index} installationPath)
    file(TO_CMAKE_PATH "${instance}" instance)
    if(EXISTS "${instance}/VC/Tools/MSVC/${TOOLSET}/bin/Hostx64/x64/cl.exe")
      string(JSON version GET "${instances}" ${index} installationVersion)
      string(REGEX MATCH "^[0-9]+" major "${version}")
      break()
    endif()
  endforeach()
  if(NOT major)
    message(FATAL_ERROR "Visual Studio is installed but MSVC toolset ${TOOLSET} is missing")
  endif()
  if(major EQUAL 17)
    set(generator "Visual Studio 17 2022")
  elseif(major EQUAL 18)
    set(generator "Visual Studio 18 2026")
  else()
    message(FATAL_ERROR "Unsupported Visual Studio version ${version}")
  endif()
  set(toolset_spec "version=${TOOLSET}")
  if(TOOLSET VERSION_GREATER_EQUAL 14.30 AND TOOLSET VERSION_LESS 14.50)
    set(toolset_spec "v143,${toolset_spec}")
  endif()
  set(options -G "${generator}" -A x64 -T "${toolset_spec}" "-DCMAKE_GENERATOR_INSTANCE=${instance}")
  set(work "${BUILD_DIR}/consumer-vs")
endif()

file(REMOVE_RECURSE "${work}")
set(prefix "${work}/relocated")
execute_process(COMMAND "${CMAKE_COMMAND}" --install "${BUILD_DIR}" --config "${BUILD_TYPE}"
  --prefix "${work}/original" COMMAND_ERROR_IS_FATAL ANY)
if(BUILD_TYPE STREQUAL "Debug" AND DEFINED ENV{ISODUO_PACKAGE_RELEASE_BUILD})
  execute_process(COMMAND "${CMAKE_COMMAND}" --install "$ENV{ISODUO_PACKAGE_RELEASE_BUILD}" --config Release
    --prefix "${work}/original" COMMAND_ERROR_IS_FATAL ANY)
  list(APPEND configs Release)
endif()
file(RENAME "${work}/original" "${prefix}")
if(CROSS_COMPILER AND "Release" IN_LIST configs)
  list(APPEND configs RelWithDebInfo)
endif()
foreach(config IN LISTS configs)
  set(binary "${work}/${config}")
  if(CROSS_COMPILER OR MULTI_CONFIG)
    set(configuration_types "-DCMAKE_CONFIGURATION_TYPES=${config}")
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}" -S "${SOURCE_DIR}/tests/package/consumer" -B "${binary}"
    ${options} ${configuration_types} "-DCMAKE_BUILD_TYPE=${config}" "-DIsoduo_DIR=${prefix}/lib/cmake/Isoduo"
    "-DEXAMPLE=${SOURCE_DIR}/examples/consumer" "-DEXPECT_DESKTOP=${DESKTOP}"
    "-DEXPECT_MSVC=${CROSS_COMPILER}" "-DEXPECT_TOOLSET=${TOOLSET}" COMMAND_ERROR_IS_FATAL ANY)
  execute_process(COMMAND "${CMAKE_COMMAND}" --build "${binary}" --config "${config}" COMMAND_ERROR_IS_FATAL ANY)
  set(required_tests profile_alias)
  if(DESKTOP)
    list(APPEND required_tests notices_smoke)
  endif()
  foreach(test IN LISTS required_tests)
    execute_process(COMMAND "${CMAKE_CTEST_COMMAND}" --test-dir "${binary}" -C "${config}"
      -R "^${test}$" --output-on-failure --no-tests=error COMMAND_ERROR_IS_FATAL ANY)
  endforeach()
  file(READ "${binary}/core-${config}.txt" core)
  set(postfix "")
  if(config STREQUAL "Debug")
    set(postfix d)
  endif()
  if(NOT EXISTS "${core}" OR NOT core MATCHES "/(lib)?isoduo_core${postfix}\\.(lib|a)$")
    message(FATAL_ERROR "${config} consumer selected unexpected Core library: ${core}")
  endif()
endforeach()
