cmake_minimum_required(VERSION 3.25)
include("${CMAKE_CURRENT_LIST_DIR}/../cmake/ci/ReleaseDecision.cmake")

set(commit "0123456789abcdef0123456789abcdef01234567")
set(ref "refs/heads/main")
set(project_text "cmake_minimum_required(VERSION 3.25)\nproject(Isoduo VERSION 0.4.0 LANGUAGES C CXX)")
set(tags "[]")
set(releases "[]")
set(core [[{"name":"Core","status":"completed","conclusion":"success","created_at":"2026-11-22T10:00:00Z"}]])
set(render [[{"name":"Render","status":"completed","conclusion":"success","created_at":"2026-11-22T10:00:00Z"}]])
set(uia [[{"name":"UIA trial","status":"completed","conclusion":"success","created_at":"2026-11-22T10:00:00Z"}]])
set(runs "[${core},${render},${uia}]")

macro(decide)
  release_decision("${ref}" "${project_text}" "${commit}" "${tags}" "${releases}" "${runs}")
endmacro()

function(expect_release version)
  decide()
  if(failure OR NOT tag STREQUAL "v${version}" OR NOT title STREQUAL "Isoduo ${version}")
    message(FATAL_ERROR "Expected Isoduo ${version}, got '${tag}' / '${title}' / '${failure}'")
  endif()
  if(NOT notes STREQUAL "Commit: `${commit}`\n\nThe project author completed real-machine verification for this version.")
    message(FATAL_ERROR "Unexpected release notes: ${notes}")
  endif()
endfunction()

function(expect_refusal pattern)
  decide()
  if(NOT failure MATCHES "${pattern}" OR tag OR title OR notes)
    message(FATAL_ERROR "Expected refusal /${pattern}/, got '${failure}' with '${tag}' / '${title}' / '${notes}'")
  endif()
endfunction()

expect_release(0.4.0)
foreach(ref IN ITEMS refs/heads/feature/release refs/tags/main)
  expect_refusal("main.*${ref}")
endforeach()
set(ref refs/heads/main)

set(project_text "PROJECT(Isoduo\n  VERSION 1.12.3\n  LANGUAGES C CXX)\n")
expect_release(1.12.3)
foreach(invalid IN ITEMS 0.4 0.4.0.1 0.4.0-rc1)
  set(project_text "project(Isoduo VERSION ${invalid} LANGUAGES C CXX)")
  expect_refusal("three numbers.*'${invalid}'")
endforeach()
set(project_text "project(Isoduo LANGUAGES C CXX)")
expect_refusal("three numbers.*''")
set(project_text "project(Isoduo VERSION 0.4.0 LANGUAGES C CXX)")

set(tags [=[["v0.3.0","v0.4.0-rc1","v0.4.01"]]=])
set(releases [[[
  {"tag_name":"v0.3.0","draft":false},
  {"tag_name":"v0.4.0-rc1","draft":true},
  {"tag_name":"v0.5.0","draft":true}
] ]])
expect_release(0.4.0)
set(tags [=[["v0.4.0"]]=])
set(releases "[]")
expect_refusal("tag v0[.]4[.]0 already exists.*bump")
set(releases [=[[{"tag_name":"v0.4.0","draft":false}]]=])
expect_refusal("v0[.]4[.]0 is already published.*bump")
set(releases [=[[{"tag_name":"v0.4.0","draft":true}]]=])
set(tags "[]")
expect_refusal("draft.*v0[.]4[.]0.*delete")
set(tags [=[["v0.4.0"]]=])
expect_refusal("tag v0[.]4[.]0 already exists.*bump")
set(releases "[]")
set(tags "[]")

string(JSON failed_uia SET "${uia}" conclusion [["failure"]])
set(runs "[${core},${render},${failed_uia}]")
expect_release(0.4.0)
string(JSON failed_core SET "${core}" conclusion [["failure"]])
set(runs "[${failed_core},${render}]")
expect_refusal("${commit}.*Core concluded failure")
string(JSON cancelled_core SET "${core}" conclusion [["cancelled"]])
set(runs "[${cancelled_core},${render}]")
expect_refusal("Core concluded cancelled")
string(JSON running_render SET "${render}" conclusion null)
string(JSON running_render SET "${running_render}" status [["in_progress"]])
set(runs "[${core},${running_render}]")
expect_refusal("Render is in_progress")
set(runs "[${core},${uia}]")
expect_refusal("Render has no run")
string(JSON queued_render SET "${running_render}" status [["queued"]])
set(runs "[${failed_core},${queued_render}]")
expect_refusal("Core concluded failure.*Render is queued")
string(JSON new_core SET "${core}" created_at [["2026-11-22T11:00:00Z"]])
set(runs "[${new_core},${failed_core},${render}]")
expect_release(0.4.0)
string(JSON new_failure SET "${failed_core}" created_at [["2026-11-22T11:00:00Z"]])
set(runs "[${core},${new_failure},${render}]")
expect_refusal("Core concluded failure")
