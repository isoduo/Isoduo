cmake_minimum_required(VERSION 3.25)

if(NOT CMAKE_HOST_WIN32 OR NOT "$ENV{RUNNER_ENVIRONMENT}" STREQUAL "github-hosted")
  message(FATAL_ERROR "VK02 loader rename requires a disposable GitHub-hosted Windows runner")
endif()
if(NOT EXISTS "${TEST_PROGRAM}")
  message(FATAL_ERROR "Missing VK02 test executable: ${TEST_PROGRAM}")
endif()
set(loader "$ENV{SystemRoot}/System32/vulkan-1.dll")
set(backup "${loader}.vk02")
if(EXISTS "${backup}")
  message(FATAL_ERROR "Unexpected loader backup: ${backup}")
endif()
if(EXISTS "${loader}")
  file(RENAME "${loader}" "${backup}")
  message(STATUS "Renamed ${loader} for VK02")
else()
  message(STATUS "System32 loader already absent for VK02")
endif()
execute_process(COMMAND "${TEST_PROGRAM}" --no-loader RESULT_VARIABLE result)
if(EXISTS "${backup}")
  file(RENAME "${backup}" "${loader}")
endif()
if(NOT result STREQUAL "0")
  message(FATAL_ERROR "VK02 failed: ${result}")
endif()
message(STATUS "VK02 passed")
