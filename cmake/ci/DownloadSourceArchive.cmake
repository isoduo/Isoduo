cmake_minimum_required(VERSION 3.25)
if(WIN32)
  set(extension zip)
else()
  set(extension tar.gz)
endif()
set(temp "$ENV{RUNNER_TEMP}")
set(archive "${temp}/source.${extension}")
set(unpacked "${temp}/unpacked")
set(url "https://github.com/$ENV{GITHUB_REPOSITORY}/archive/$ENV{SOURCE_SHA}.${extension}")
file(DOWNLOAD "${url}" "${archive}" TLS_VERIFY ON STATUS status)
list(GET status 0 code)
if(NOT code EQUAL 0)
  message(FATAL_ERROR "Downloading ${url} failed: ${status}")
endif()

file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${unpacked}")
file(GLOB entries "${unpacked}/*")
list(LENGTH entries count)
if(NOT count EQUAL 1 OR NOT IS_DIRECTORY "${entries}")
  message(FATAL_ERROR "Expected one top-level directory in ${archive}, found: ${entries}")
endif()
file(GLOB_RECURSE git_entries LIST_DIRECTORIES true "${entries}/*")
list(FILTER git_entries INCLUDE REGEX "/[.]git$")
if(git_entries)
  message(FATAL_ERROR "The source archive contains .git: ${git_entries}")
endif()
# Use a short build root for Windows dependency paths.
file(RENAME "${entries}" "${temp}/Isoduo")
