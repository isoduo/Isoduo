# All inputs are supplied by the caller. Tags are a JSON array of names;
# releases and runs are JSON arrays of GitHub API objects.
function(release_decision ref project_text commit tags releases runs)
  foreach(output IN ITEMS tag title notes failure)
    set(${output} "" PARENT_SCOPE)
  endforeach()

  string(REGEX MATCH "(^|\n)[ \t\r\n]*[Pp][Rr][Oo][Jj][Ee][Cc][Tt][ \t\r\n]*\\([ \t\r\n]*Isoduo[ \t\r\n]+VERSION[ \t\r\n]+([^ \t\r\n)]+)" declaration "${project_text}")
  set(version "${CMAKE_MATCH_2}")
  if(NOT ref STREQUAL "refs/heads/main")
    set(failure "Releases are made only from main; this run started from ${ref}." PARENT_SCOPE)
    return()
  endif()
  if(NOT version MATCHES "^[0-9]+[.][0-9]+[.][0-9]+$")
    set(failure "project(Isoduo VERSION ...) in CMakeLists.txt must be three numbers such as 0.4.0; found '${version}'." PARENT_SCOPE)
    return()
  endif()
  set(tag "v${version}")
  set(bump "bump project(Isoduo VERSION ...) in CMakeLists.txt first.")
  set(has_draft FALSE)
  string(JSON count LENGTH "${releases}")
  set(i 0)
  while(i LESS count)
    string(JSON release_tag GET "${releases}" ${i} tag_name)
    if(release_tag STREQUAL tag)
      string(JSON draft GET "${releases}" ${i} draft)
      if(NOT draft)
        set(failure "Release ${tag} is already published; ${bump}" PARENT_SCOPE)
        return()
      endif()
      set(has_draft TRUE)
    endif()
    math(EXPR i "${i} + 1")
  endwhile()

  string(JSON count LENGTH "${tags}")
  set(i 0)
  while(i LESS count)
    string(JSON existing GET "${tags}" ${i})
    if(existing STREQUAL tag)
      set(failure "The tag ${tag} already exists; ${bump}" PARENT_SCOPE)
      return()
    endif()
    math(EXPR i "${i} + 1")
  endwhile()
  if(has_draft)
    set(failure "A draft release for ${tag} already exists; delete it on the Releases page and run the workflow again." PARENT_SCOPE)
    return()
  endif()
  string(JSON count LENGTH "${runs}")
  set(problems "")
  foreach(required IN ITEMS Core Render)
    set(latest "")
    set(i 0)
    while(i LESS count)
      string(JSON name GET "${runs}" ${i} name)
      if(name STREQUAL required)
        string(JSON created GET "${runs}" ${i} created_at)
        if(created STRGREATER latest)
          set(latest "${created}")
          string(JSON status GET "${runs}" ${i} status)
          string(JSON conclusion GET "${runs}" ${i} conclusion)
        endif()
      endif()
      math(EXPR i "${i} + 1")
    endwhile()
    if(NOT latest)
      list(APPEND problems "${required} has no run")
    elseif(NOT status STREQUAL "completed")
      list(APPEND problems "${required} is ${status}")
    elseif(NOT conclusion STREQUAL "success")
      list(APPEND problems "${required} concluded ${conclusion}")
    endif()
  endforeach()
  if(problems)
    list(JOIN problems "; " reason)
    set(failure "Core and Render must succeed on ${commit} first: ${reason}." PARENT_SCOPE)
    return()
  endif()

  set(tag "${tag}" PARENT_SCOPE)
  set(title "Isoduo ${version}" PARENT_SCOPE)
  set(notes "Commit: `${commit}`\n\nThe project author completed real-machine verification for this version." PARENT_SCOPE)
endfunction()
