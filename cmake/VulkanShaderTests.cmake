set(shader_dir "${PROJECT_SOURCE_DIR}/src/vulkan_shaders")
add_executable(isoduo_vulkan_shader_data tests/vulkan_shader_data.cpp)
isoduo_target(isoduo_vulkan_shader_data)
target_include_directories(isoduo_vulkan_shader_data PRIVATE "${shader_dir}")

find_program(glslang_tool NAMES glslang glslangValidator)
find_program(spirv_val_tool spirv-val)
if(glslang_tool)
  execute_process(COMMAND "${glslang_tool}" --version OUTPUT_VARIABLE version)
  if(NOT version MATCHES "Glslang Version: [0-9]+:16[.]6[.]0([\r\n]|$)")
    unset(glslang_tool CACHE)
  endif()
endif()
foreach(mode regenerate validate)
  if(mode STREQUAL "regenerate")
    set(tool "${glslang_tool}")
    set(required "glslang 16.6.0")
  else()
    set(tool "${spirv_val_tool}")
    set(required spirv-val)
  endif()
  if(tool)
    add_test(NAME vulkan_shaders_${mode} COMMAND "${CMAKE_COMMAND}" "-DSOURCE=${shader_dir}"
      "-DOUT=${PROJECT_BINARY_DIR}/vulkan-shaders-${mode}" "-DDATA=$<TARGET_FILE:isoduo_vulkan_shader_data>"
      "-DMODE=${mode}" "-DTOOL=${tool}" -P "${PROJECT_SOURCE_DIR}/tests/vulkan_shaders.cmake")
  else()
    add_test(NAME vulkan_shaders_${mode} COMMAND isoduo_vulkan_shader_data --skip "Missing ${required}")
  endif()
  set_tests_properties(vulkan_shaders_${mode} PROPERTIES SKIP_RETURN_CODE 77)
endforeach()
