cmake_minimum_required(VERSION 3.25)
if(NOT DEFINED SOURCE OR NOT DEFINED TARGET)
  message(FATAL_ERROR "Supply -DSOURCE=<VerticalOrientation.txt> and -DTARGET=<output.inc> before -P")
endif()
file(SHA256 "${SOURCE}" digest)
file(STRINGS "${SOURCE}" header LIMIT_COUNT 1)
if(NOT header MATCHES "^# (VerticalOrientation-[0-9.]+[.]txt)")
  message(FATAL_ERROR "Missing Unicode data version in ${SOURCE}")
endif()
set(name "${CMAKE_MATCH_1}")
# Retain the original banner for byte-for-byte reproducibility.
set(output "// Generated by third_party/unicode/gen_vertical_orientation.py; do not edit by hand.\n")
string(APPEND output "// Source: ${name} (Unicode Character Database, UAX #50 Vertical_Orientation)\n"
  "// SHA256: ${digest}\n// Code points that are not listed are R (rotated).\n")

function(emit_range)
  foreach(bound IN ITEMS first last)
    math(EXPR hex "${${bound}}" OUTPUT_FORMAT HEXADECIMAL)
    string(SUBSTRING "${hex}" 2 -1 hex)
    string(TOUPPER "${hex}" hex)
    set(${bound} "0x${hex}")
  endforeach()
  set(output "${output}{${first}, ${last}, VerticalOrientation::${value}},\n" PARENT_SCOPE)
endfunction()

file(STRINGS "${SOURCE}" records ENCODING UTF-8 REGEX "^[^#]")
foreach(record IN LISTS records)
  string(REGEX REPLACE "#.*" "" record "${record}")
  string(STRIP "${record}" record)
  if(record STREQUAL "")
    continue()
  endif()
  if(NOT record MATCHES "^([0-9A-Fa-f]+)([.][.]([0-9A-Fa-f]+))?[ \t]*;[ \t]*(R|U|Tu|Tr)$")
    message(FATAL_ERROR "Invalid Vertical_Orientation record: ${record}")
  endif()
  set(property "${CMAKE_MATCH_4}")
  if(property STREQUAL "R")
    continue()
  endif()
  math(EXPR begin "0x${CMAKE_MATCH_1}")
  if(CMAKE_MATCH_3)
    math(EXPR end "0x${CMAKE_MATCH_3}")
  else()
    set(end "${begin}")
  endif()
  if(DEFINED last)
    math(EXPR adjacent "${last} + 1")
    if(begin EQUAL adjacent AND property STREQUAL value)
      set(last "${end}")
      continue()
    endif()
    emit_range()
  endif()
  set(first "${begin}")
  set(last "${end}")
  set(value "${property}")
endforeach()
if(DEFINED last)
  emit_range()
endif()
file(CONFIGURE OUTPUT "${TARGET}" CONTENT "@output@" @ONLY NEWLINE_STYLE UNIX)
